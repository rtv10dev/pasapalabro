{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pasapalabra",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-22",
  "build": {
    "command": "npm run build:client",
    "watch_dir": ["src/client", "src/shared"],
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/m/*"],
  },
  "durable_objects": {
    "bindings": [
      { "name": "MATCH", "class_name": "Match" },
      { "name": "STOCK", "class_name": "Stock" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Match"] },
    { "tag": "v2", "new_sqlite_classes": ["Stock"] },
  ],
  // Workers AI runs gpt-oss-120b, the fallback when Gemini fails (ADR 0004).
  "ai": { "binding": "AI", "remote": true },
  // The Gemini key: `wrangler secret put GEMINI_API_KEY`, or `.dev.vars` locally.
  "secrets": { "required": ["GEMINI_API_KEY"] },
  // Tops the Stock up with one Rosco per run (src/worker/index.ts).
  "triggers": { "crons": ["*/5 * * * *"] },
}
