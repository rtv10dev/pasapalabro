{
  "name": "pasapalabra",
  "private": true,
  "type": "module",
  "scripts": {
    "build:client": "esbuild src/client/main.ts --bundle --splitting --format=esm --target=es2022 --outdir=public --entry-names=app --chunk-names=chunks/[name]-[hash]",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc -p src/shared && tsc -p src/rules && tsc -p src/clues && tsc -p src/worker && tsc -p src/client && tsc -p test/rules && tsc -p test/client && tsc -p test/fixtures && tsc -p test/clues && tsc -p test/workers",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "~4.1.11",
    "wrangler": "^4.147.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261001.1": true
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "uqr": "^0.1.3",
    "zod": "^4.6.5"
  }
}
