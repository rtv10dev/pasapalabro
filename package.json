{
  "name": "pasapalabra",
  "private": true,
  "type": "module",
  "scripts": {
    "build:client": "esbuild src/client/main.ts --bundle --format=esm --target=es2022 --outfile=public/app.js",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc -p src/shared && tsc -p src/worker && tsc -p src/client && tsc -p test",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "~4.1.11",
    "wrangler": "^4.147.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261001.1": true
  }
}
